{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.pouyahasanamreji/continuum",
  "description": "The MCP-native memory layer for agent swarms. Persistent vector memory, semantic knowledge recall, and multi-agent orchestration. Local-first SQLite + sqlite-vec.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/pouyahasanamreji/continuum",
    "source": "github"
  },
  "websiteUrl": "https://github.com/pouyahasanamreji/continuum",
  "packages": [
    {
      "registryType": "oci",
      "registryBaseUrl": "https://docker.io",
      "identifier": "pouyahasanamreji/continuum",
      "version": "0.1.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:7776/mcp"
      },
      "runtimeArguments": [
        { "type": "named", "name": "-p", "value": "7776:7776" },
        { "type": "named", "name": "-v", "value": "continuum-data:/data" }
      ],
      "environmentVariables": [
        {
          "name": "ORCHESTRATOR_DB_PATH",
          "description": "SQLite path inside container",
          "default": "/data/orchestrator.db"
        },
        {
          "name": "EMBEDDER_URL",
          "description": "Optional HTTP embedder (Ollama/TEI/OpenAI-compatible). Unset = in-process embedder.",
          "isRequired": false
        },
        {
          "name": "EMBEDDER_MODEL",
          "description": "Embedding model id",
          "default": "Snowflake/snowflake-arctic-embed-m-v1.5"
        },
        {
          "name": "EMBEDDER_DIM",
          "description": "Embedding vector dimension",
          "default": "768"
        }
      ]
    }
  ]
}
